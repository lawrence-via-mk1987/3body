[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1_main"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1, 0.12, 0.18, 1)

[node name="CenterPanel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -180.0
offset_right = 220.0
offset_bottom = 180.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="CenterPanel"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 28

[node name="VBox" type="VBoxContainer" parent="CenterPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="CenterPanel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Kairos Redeemer"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="CenterPanel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.78, 0.85, 1)
text = "Vertical Slice — Prologue"
horizontal_alignment = 1

[node name="HintLabel" type="Label" parent="CenterPanel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.58, 0.63, 0.72, 1)
theme_override_font_sizes/font_size = 12
text = "Click or use Arrow keys + Enter · F3 = debug menu in game"
horizontal_alignment = 1

[node name="SaveSummaryLabel" type="Label" parent="CenterPanel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.74, 0.82, 1)
text = "No saved journey yet."
horizontal_alignment = 1

[node name="NewGameButton" type="Button" parent="CenterPanel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "New Game"

[node name="ContinueButton" type="Button" parent="CenterPanel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Continue"

[node name="QuitButton" type="Button" parent="CenterPanel/Margin/VBox"]
layout_mode = 2
text = "Quit"

[connection signal="pressed" from="CenterPanel/Margin/VBox/NewGameButton" to="." method="_on_new_game_pressed"]
[connection signal="pressed" from="CenterPanel/Margin/VBox/ContinueButton" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="CenterPanel/Margin/VBox/QuitButton" to="." method="_on_quit_pressed"]
