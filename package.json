{
  "name": "3body",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:pages": "tsc && cross-env GITHUB_PAGES=true vite build",
    "preview": "vite preview",
    "preview:pages": "cross-env GITHUB_PAGES=true vite preview",
    "assets:pit-hero": "node scripts/generate-pit-hero-glb.mjs",
    "assets:heroes": "node scripts/generate-hero-gltf-assets.mjs",
    "assets:heroes:compress": "node scripts/compress-hero-gltf.mjs",
    "assets:heroes:all": "npm run assets:heroes && npm run assets:heroes:compress",
    "assets:heroes:ktx2": "node scripts/generate-hero-ktx2.mjs",
    "assets:luts": "node scripts/generate-era-luts.mjs",
    "assets:path-a-m4": "npm run assets:heroes:ktx2 && npm run assets:luts",
    "export:unity": "tsx scripts/export-unity-snapshot.ts"
  },
  "dependencies": {
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.177.0",
    "cross-env": "^7.0.3",
    "draco3dgltf": "^1.5.7",
    "ktx2-encoder": "^0.6.0",
    "sharp": "^0.35.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
